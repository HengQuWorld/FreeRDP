<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Theme.Settings" parent="@style/Theme.AppCompat.Light.DarkActionBar">
        <item name="android:listSeparatorTextViewStyle">@style/SettingsCategory</item>
        <item name="colorPrimary">@color/tiger_primary</item>
        <item name="colorPrimaryDark">@color/tiger_primary</item>
        <item name="colorAccent">@color/tiger_primary</item>
        <item name="android:windowBackground">@color/tiger_surface</item>
    </style>

    <style name="Theme.Main" parent="@style/Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/tiger_primary</item>
        <item name="colorPrimaryDark">@color/tiger_primary</item>
        <item name="colorAccent">@color/tiger_primary</item>
        <item name="android:windowBackground">@color/tiger_surface</item>
    </style>

    <style name="SettingsCategory">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">25dip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">5sp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/separator_background</item>
        <item name="android:textColor">@color/tiger_primary</item>
    </style>

    <style name="ButtonText">
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">18dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/tiger_on_primary</item>
    </style>

    <style name="LabelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/tiger_text_primary</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">14dp</item>
    </style>

    <style name="GetStartedHeaderText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/tiger_text_primary</item>
        <item name="android:textSize">18dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
    </style>

    <style name="GetStartedText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/tiger_text_secondary</item>
        <item name="android:textSize">15dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>

    </style>
</resources>
