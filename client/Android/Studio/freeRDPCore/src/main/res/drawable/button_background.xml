<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E02C4F54" />
            <stroke android:width="1dp" android:color="#2C4F54" />
            <corners android:radius="8dp" />
            <padding android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/tiger_primary_container" />
            <stroke android:width="1dp" android:color="@color/tiger_primary" />
            <corners android:radius="8dp" />
            <padding android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/tiger_primary" />
            <stroke android:width="1dp" android:color="#1F2C4F54" />
            <corners android:radius="8dp" />
            <padding android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp" />
        </shape>
    </item>
</selector> 
